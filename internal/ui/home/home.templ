package home

import (
	"appointment-manager/internal/i18n"
	"appointment-manager/internal/ui/layout"
)

templ Home() {
	@layout.Base(i18n.T(ctx, "home.title"), true) {
		<div class="text-center">
			<h1 class="text-4xl font-bold mb-4">{ i18n.T(ctx, "home.welcome") }</h1>
			<p class="text-lg text-gray-600">{ i18n.T(ctx, "home.tagline") }</p>
		</div>
	}
}
