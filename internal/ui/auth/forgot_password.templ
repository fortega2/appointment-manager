package auth

import (
	"appointment-manager/internal/i18n"
	"appointment-manager/internal/ui/layout"
)

// ForgotPassword asks for an address and nothing else. Its message slot is
// neutral rather than red, since the usual answer is a notice.
templ ForgotPassword() {
	@layout.Base(i18n.T(ctx, "auth.forgot.title"), false) {
		<div class="w-full max-w-md mx-auto mt-20">
			<div class="bg-white p-8 rounded-lg shadow-md border border-gray-100">
				<h2 class="text-2xl font-bold text-center text-gray-800 mb-2">{ i18n.T(ctx, "auth.forgot.title") }</h2>
				<p class="text-sm text-gray-600 text-center mb-6">{ i18n.T(ctx, "auth.forgot.description") }</p>
				<form
					hx-post="/forgot-password"
					hx-target="#reset-message"
					hx-swap="innerHTML"
					class="space-y-5"
				>
					<div>
						<label for="email" class="block text-sm font-medium text-gray-700">{ i18n.T(ctx, "auth.forgot.email") }</label>
						<input
							type="email"
							name="email"
							id="email"
							required
							class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
						/>
					</div>
					<div id="reset-message" class="text-gray-700 text-sm text-center font-medium min-h-10"></div>
					<button
						type="submit"
						class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
					>
						{ i18n.T(ctx, "auth.forgot.submit") }
					</button>
				</form>
				<p class="mt-6 text-center text-sm">
					<a href="/login" class="text-indigo-600 hover:text-indigo-700">{ i18n.T(ctx, "auth.forgot.back") }</a>
				</p>
			</div>
		</div>
	}
}