package auth

import (
	"appointment-manager/internal/i18n"
	"appointment-manager/internal/password"
	"appointment-manager/internal/ui/layout"

	"strconv"
)

// ResetPassword carries the token in a hidden field so the POST needs no query
// string of its own.
templ ResetPassword(token string) {
	@layout.Base(i18n.T(ctx, "auth.reset.title"), false) {
		<div class="w-full max-w-md mx-auto mt-20">
			<div class="bg-white p-8 rounded-lg shadow-md border border-gray-100">
				<h2 class="text-2xl font-bold text-center text-gray-800 mb-6">{ i18n.T(ctx, "auth.reset.title") }</h2>
				<form
					hx-post="/reset-password"
					hx-target="#reset-error"
					hx-swap="innerHTML"
					class="space-y-5"
				>
					<input type="hidden" name="token" value={ token }/>
					<div>
						<label for="password" class="block text-sm font-medium text-gray-700">{ i18n.T(ctx, "auth.reset.password") }</label>
						<input
							type="password"
							name="password"
							id="password"
							required
							minlength={ strconv.Itoa(password.MinLength) }
							maxlength={ strconv.Itoa(password.MaxLength) }
							class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
						/>
						<p class="mt-1 text-xs text-gray-500">
							{ i18n.T(ctx, "auth.reset.hint", i18n.M{"count": password.MinLength}) }
						</p>
					</div>
					<div>
						<label for="password_confirmation" class="block text-sm font-medium text-gray-700">{ i18n.T(ctx, "auth.reset.confirmation") }</label>
						<input
							type="password"
							name="password_confirmation"
							id="password_confirmation"
							required
							class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
						/>
					</div>
					<div id="reset-error" class="text-red-500 text-sm text-center font-medium min-h-10"></div>
					<button
						type="submit"
						class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
					>
						{ i18n.T(ctx, "auth.reset.submit") }
					</button>
				</form>
			</div>
		</div>
	}
}

// ResetPasswordExpired replaces the form when the link is spent, so nobody
// types a password only to be told afterwards that it was pointless.
templ ResetPasswordExpired() {
	@layout.Base(i18n.T(ctx, "auth.reset.expired_title"), false) {
		<div class="w-full max-w-md mx-auto mt-20">
			<div class="bg-white p-8 rounded-lg shadow-md border border-gray-100 text-center">
				<h2 class="text-2xl font-bold text-gray-800 mb-4">{ i18n.T(ctx, "auth.reset.expired_title") }</h2>
				<p class="text-sm text-gray-600 mb-6">{ i18n.T(ctx, "auth.reset.expired") }</p>
				<a
					href="/forgot-password"
					class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700"
				>
					{ i18n.T(ctx, "auth.reset.request_another") }
				</a>
			</div>
		</div>
	}
}