package slot

import (
	"appointment-manager/internal/i18n"
	"appointment-manager/internal/ui/components"
	"appointment-manager/internal/ui/layout"
	"fmt"
	"time"
)

templ Dashboard(dto []ListDTO, pDTO []ProfessionalDTO) {
    @layout.Base(i18n.T(ctx, "slot.title"), true) {
        <div 
            class="w-full max-w-5xl mx-auto" 
            x-data="{ 
                weekStart: '', weekEnd: '', 
                startTime: '', endTime: '', 
                professionalID: '', 
                modalOpen: false 
            }" 
            @close-modal.window="modalOpen = false"
        >
            @Filters(pDTO)
            if len(dto) == 0 {
                <div id="dto-table" class="mt-6 p-12 bg-white border border-gray-200 rounded-lg text-center shadow-sm">
                    <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                    <h3 class="mt-2 text-sm font-semibold text-gray-900">{ i18n.T(ctx, "slot.empty.title") }</h3>
                    <p class="mt-1 text-sm text-gray-500">{ i18n.T(ctx, "slot.empty.body") }</p>
                </div>
            } else {
                @Table(dto)
            }

            <div 
                x-show="modalOpen" 
                class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 transition-opacity"
                x-cloak
            >
                <div 
                    class="bg-white rounded-lg shadow-xl w-full max-w-md p-6 relative text-left"
                    @click.away="modalOpen = false"
                >
                    @components.ModalCloseButton()

                    <div id="modal-content"></div>
                </div>
            </div>
        </div>
    }
}

templ Filters(pDTO []ProfessionalDTO) {
    <div class="mb-4 flex flex-col space-y-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center space-x-4">
                <div class="flex items-center space-x-2">
                    <label class="text-sm font-medium text-gray-700">{ i18n.T(ctx, "slot.filters.week") }</label>
                    <input type="date" x-model="weekStart" class="bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 p-2" />
                    <span class="text-gray-500">{ i18n.T(ctx, "slot.filters.to") }</span>
                    <input type="date" x-model="weekEnd" class="bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 p-2" />
                </div>
                
                <div class="flex items-center space-x-2">
                    <label class="text-sm font-medium text-gray-700">{ i18n.T(ctx, "slot.filters.time") }</label>
                    <input type="time" x-model="startTime" class="bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 p-2" />
                    <span class="text-gray-500">{ i18n.T(ctx, "slot.filters.to") }</span>
                    <input type="time" x-model="endTime" class="bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 p-2" />
                </div>
            </div>
            
            <div class="flex items-center space-x-4">
                <button 
                    type="button" 
                    @click="weekStart = ''; weekEnd = ''; startTime = ''; endTime = ''; professionalID = ''" 
                    class="text-sm text-blue-600 hover:underline"
                >
                    { i18n.T(ctx, "slot.filters.reset") }
                </button>

                <button 
                    type="button"
                    hx-get="/slots/new" 
                    hx-target="#modal-content" 
                    @click="modalOpen = true"
                    class="bg-indigo-600 text-white text-sm font-medium px-4 py-2 rounded-md hover:bg-indigo-700 transition-colors"
                >
                    { i18n.T(ctx, "slot.create") }
                </button>
            </div>
        </div>

        <div class="flex items-center space-x-2 w-full max-w-xs">
            <label class="text-sm font-medium text-gray-700">{ i18n.T(ctx, "slot.filters.professional") }</label>
            <select x-model="professionalID" class="bg-white border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5">
                <option value="">{ i18n.T(ctx, "slot.filters.all_professionals") }</option>
                for _, p := range pDTO {
                    <option value={ p.ID }>{ p.FirstName } { p.LastName }</option>
                }
            </select>
        </div>
    </div>
}

templ Table(dto []ListDTO) {
    {{
        availableLabel := i18n.T(ctx, "slot.status.available")
        blockedLabel := i18n.T(ctx, "slot.status.blocked")
        cancelTitle := i18n.T(ctx, "slot.action.cancel")
        cancelLabel := i18n.T(ctx, "slot.action.cancel_label")
        confirmMessage := i18n.T(ctx, "slot.action.confirm")
    }}
    <div id="dto-table" class="overflow-x-auto shadow-sm border border-gray-200 rounded-lg">
        <table class="w-full text-sm text-left border-collapse">
            <thead class="bg-gray-100 text-gray-600 uppercase text-xs">
                <tr>
                    <th class="px-4 py-3">{ i18n.T(ctx, "slot.table.date") }</th>
                    <th class="px-4 py-3">{ i18n.T(ctx, "slot.table.time") }</th>
                    <th class="px-4 py-3">{ i18n.T(ctx, "slot.table.professional") }</th>
                    <th class="px-4 py-3">{ i18n.T(ctx, "slot.table.max_capacity") }</th>
                    <th class="px-4 py-3">{ i18n.T(ctx, "slot.table.status") }</th>
                    <th class="px-4 py-3">{ i18n.T(ctx, "slot.table.action") }</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                for _, s := range dto {
                    <tr
                        class="bg-white hover:bg-gray-50 transition-colors"
                        data-utc-start={ s.StartTime.UTC().Format(time.RFC3339) }
                        data-utc-end={ s.EndTime.UTC().Format(time.RFC3339) }
                        data-date={ s.StartTime.UTC().Format("2006-01-02") }
                        data-start={ s.StartTime.UTC().Format("15:04") }
                        data-end={ s.EndTime.UTC().Format("15:04") }
                        data-prof={ s.ProfessionalID }
                        x-show="
                            (!weekStart || $el.dataset.date >= weekStart) &&
                            (!weekEnd || $el.dataset.date <= weekEnd) &&
                            (!startTime || $el.dataset.start >= startTime) &&
                            (!endTime || $el.dataset.end <= endTime) &&
                            (!professionalID || $el.dataset.prof === professionalID)
                        "
                    >
                        <td class="px-4 py-3 text-gray-800 font-medium" data-role="date">{ s.StartTime.UTC().Format("2006-01-02") }</td>
                        <td class="px-4 py-3 text-gray-800" data-role="time">{ s.StartTime.UTC().Format("15:04") } - { s.EndTime.UTC().Format("15:04") }</td>
                        <td class="px-4 py-3 text-gray-500">{ s.ProfessionalName }</td>
                        <td class="px-4 py-3 text-gray-500">{ fmt.Sprint(s.MaxCapacity) }</td>
                        <td class="px-4 py-3">
                            if !s.Blocked {
                                <span class="bg-green-100 text-green-700 text-xs font-medium px-2 py-1 rounded-full">{ availableLabel }</span>
                            } else {
                                <span class="bg-red-100 text-red-600 text-xs font-medium px-2 py-1 rounded-full">{ blockedLabel }</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-center align-middle">
                            if !s.Blocked {
                                <button
                                    type="button"
                                    title={ cancelTitle }
                                    aria-label={ cancelLabel }
                                    hx-delete={ string(templ.URL(fmt.Sprintf("/slots/%s", s.ID))) }
                                    hx-target="#dto-table"
                                    hx-swap="outerHTML"
                                    hx-confirm={ confirmMessage }
                                    class="text-red-600 hover:text-red-900"
                                >
                                    ✖
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

func formatUTCValue(t time.Time) string {
	if t.IsZero() {
		return ""
	}
	return t.UTC().Format(time.RFC3339)
}

templ Form(s ListDTO, actionURL string, pDTO []ProfessionalDTO) {
    <div>
        <h2 class="text-xl font-bold text-gray-900 mb-4">
            { i18n.T(ctx, "slot.form.title") }
        </h2>

        <form
            hx-post={ actionURL }
            hx-target="#dto-table"
            hx-swap="outerHTML"
            data-slot-form
            class="space-y-4"
        >
            <div>
                <label for="professional_id" class="block text-sm font-medium text-gray-700">{ i18n.T(ctx, "slot.form.professional") }</label>
                <select
                    id="professional_id"
                    name="professional_id"
                    required
                    class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm bg-white"
                >
                    <option value="" disabled selected?={ s.ProfessionalID == "" }>{ i18n.T(ctx, "slot.form.select_professional") }</option>
                    for _, p := range pDTO {
                        <option value={ p.ID } selected?={ s.ProfessionalID == p.ID }>{ p.FirstName } { p.LastName }</option>
                    }
                </select>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="start_time_local" class="block text-sm font-medium text-gray-700">{ i18n.T(ctx, "slot.form.start_time") }</label>
                    <input
                        type="datetime-local"
                        id="start_time_local"
                        name="start_time"
                        data-role="start-local"
                        data-utc-value={ formatUTCValue(s.StartTime) }
                        required
                        class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                    />
                </div>
                <div>
                    <label for="end_time_local" class="block text-sm font-medium text-gray-700">{ i18n.T(ctx, "slot.form.end_time") }</label>
                    <input
                        type="datetime-local"
                        id="end_time_local"
                        name="end_time"
                        data-role="end-local"
                        data-utc-value={ formatUTCValue(s.EndTime) }
                        required
                        class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm"
                    />
                </div>
            </div>

            <div>
                <label for="max_capacity" class="block text-sm font-medium text-gray-700">{ i18n.T(ctx, "slot.form.max_capacity") }</label>
                <input 
                    type="number" 
                    id="max_capacity" 
                    name="max_capacity" 
                    value={ fmt.Sprint(s.MaxCapacity) }
                    if s.MaxCapacity == 0 {
                        value="1"
                    }
                    min="1"
                    required 
                    class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" 
                />
            </div>

            @components.FormActions()
        </form>
    </div>
}
