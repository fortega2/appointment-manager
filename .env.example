ENV=development
LOG_LEVEL=debug
DEFAULT_LOCALE=es
DATABASE_URL=postgres://user:password@localhost:5432/database?sslmode=disable
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_BUCKET=your-bucket-name
STORAGE_REGION=
STORAGE_USE_SSL=false
WORKER_TICKER_INTERVAL=1h
# Notification queue. Both are optional: unset falls back to 1m / 100 with a startup warning.
NOTIFICATION_TICKER_INTERVAL=1m
NOTIFICATION_BUFFER_SIZE=100
METRICS_ADDR=:9090
# OpenTelemetry tracing (Tempo, OTLP/HTTP). Leave the endpoint empty to disable tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATIO=1.0
OTEL_SERVICE_VERSION=dev
DB_POOL_MAX_CONNS=15
DB_POOL_MIN_CONNS=2
DB_POOL_MAX_CONN_LIFETIME=30m
DB_POOL_MAX_CONN_LIFETIME_JITTER=5m
DB_POOL_MAX_CONN_IDLE_TIME=5m
DB_POOL_HEALTH_CHECK_PERIOD=1m