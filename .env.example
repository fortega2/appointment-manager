ENV=development
LOG_LEVEL=debug
DEFAULT_LOCALE=es
DATABASE_URL=postgres://user:password@localhost:5432/database?sslmode=disable
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_BUCKET=your-bucket-name
STORAGE_REGION=
STORAGE_USE_SSL=false
WORKER_TICKER_INTERVAL=1h
# Notification queue. Both are optional: unset falls back to 1m / 100 with a startup warning.
NOTIFICATION_TICKER_INTERVAL=1m
NOTIFICATION_BUFFER_SIZE=100
METRICS_ADDR=:9090
# Login rate limiting (in-memory, per account and per client IP). All optional.
# Refill values are the time to earn back ONE attempt, not a window length.
# Unset ENABLED means on: a missing variable must never silently disable it.
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_ACCOUNT_BURST=5
LOGIN_RATE_LIMIT_ACCOUNT_REFILL=3m
LOGIN_RATE_LIMIT_IP_BURST=20
LOGIN_RATE_LIMIT_IP_REFILL=30s
LOGIN_RATE_LIMIT_MAX_ENTRIES=10000
# OpenTelemetry tracing (Tempo, OTLP/HTTP). Leave the endpoint empty to disable tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLE_RATIO=1.0
OTEL_SERVICE_VERSION=dev
DB_POOL_MAX_CONNS=15
DB_POOL_MIN_CONNS=2
DB_POOL_MAX_CONN_LIFETIME=30m
DB_POOL_MAX_CONN_LIFETIME_JITTER=5m
DB_POOL_MAX_CONN_IDLE_TIME=5m
DB_POOL_HEALTH_CHECK_PERIOD=1m
# Origin the password reset link is built from. Required, and never taken from
# the request: a forged Host header would put an attacker's domain in the mail.
APP_BASE_URL=http://localhost:8080
# Outbound mail. SMTP_USE_TLS=false is for a local catcher such as Mailpit only;
# against a remote relay it puts the password below on the wire in the clear.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@localhost
SMTP_FROM_NAME=Turnos
SMTP_USE_TLS=false
# Password reset. Its rate limiter is separate from the login one and has no
# off switch: every granted request puts a mail in somebody else's inbox.
PASSWORD_RESET_TOKEN_TTL=30m
PASSWORD_RESET_RATE_LIMIT_ACCOUNT_BURST=3
PASSWORD_RESET_RATE_LIMIT_ACCOUNT_REFILL=15m
PASSWORD_RESET_RATE_LIMIT_IP_BURST=10
PASSWORD_RESET_RATE_LIMIT_IP_REFILL=5m
